{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "customConditions": ["@deeptokens/source"]
  },
  "include": [
    "packages/*/*.ts",
    "packages/*/lib/**/*.ts",
    "packages/*/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
